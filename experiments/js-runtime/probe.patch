+++ b/crates/dupin/src/js_probe.rs
@@ -0,0 +1,108 @@
+use std::{
+    cell::Cell,
+    error::Error,
+    rc::Rc,
+    time::{Duration, Instant},
+};
+
+use rquickjs::{CatchResultExt, Context, Function, Module, Object, Runtime, Value, WriteOptions};
+
+const HEAP_LIMIT: usize = 16 * 1024 * 1024;
+const STACK_LIMIT: usize = 512 * 1024;
+const BUDGET: Duration = Duration::from_millis(100);
+const WORD_COUNT: &str = r#"
+export function search(query) {
+    const input = query.trim();
+    if (!input) return [];
+    const count = input.split(/\s+/u).length;
+    return [{ title: `${count} words`, text: String(count) }];
+}
+"#;
+const BUSY_LOOP: &str = "export function search() { for (;;) {} }";
+
+pub(super) fn dispatch() -> bool {
+    let mut args = std::env::args().skip(1);
+    match args.next().as_deref() {
+        Some("--dupin-js-runtime-probe") => {
+            let query = args.next().unwrap_or_else(|| "two words".to_owned());
+            if let Err(error) = probe(&query) {
+                eprintln!("JS runtime probe failed: {error}");
+                std::process::exit(1);
+            }
+            true
+        }
+        _ => false,
+    }
+}
+
+type Limited = (Runtime, Context, Rc<Cell<bool>>);
+
+fn limited() -> Result<Limited, Box<dyn Error>> {
+    let runtime = Runtime::new()?;
+    runtime.set_memory_limit(HEAP_LIMIT);
+    runtime.set_max_stack_size(STACK_LIMIT);
+    let deadline = Instant::now() + BUDGET;
+    let interrupted = Rc::new(Cell::new(false));
+    let flag = Rc::clone(&interrupted);
+    runtime.set_interrupt_handler(Some(Box::new(move || {
+        let expired = Instant::now() >= deadline;
+        if expired {
+            flag.set(true);
+        }
+        expired
+    })));
+    let context = Context::full(&runtime)?;
+    Ok((runtime, context, interrupted))
+}
+
+fn probe(query: &str) -> Result<(), Box<dyn Error>> {
+    let (_runtime, context, _) = limited()?;
+    let bytecode = context.with(|ctx| {
+        Module::declare(ctx.clone(), "main.js", WORD_COUNT)
+            .and_then(|module| module.write(WriteOptions::default()))
+            .catch(&ctx)
+            .map_err(|error| error.to_string())
+    })?;
+    drop(context);
+
+    let (_runtime, context, _) = limited()?;
+    let (title, text) = context.with(|ctx| {
+        // The bytecode was written above from trusted source.
+        let rows = unsafe { Module::load(ctx.clone(), &bytecode) }
+            .and_then(|module| module.eval())
+            .and_then(|(module, promise)| promise.finish::<()>().map(|()| module))
+            .and_then(|module| module.get::<_, Function>("search"))
+            .and_then(|search| search.call::<_, Value>((query,)))
+            .catch(&ctx)
+            .map_err(|error| error.to_string())?;
+        let row: Object = rows
+            .as_array()
+            .ok_or("search must return an array")?
+            .get(0)
+            .map_err(|error| error.to_string())?;
+        let title: String = row.get("title").map_err(|error| error.to_string())?;
+        let text: String = row.get("text").map_err(|error| error.to_string())?;
+        Ok::<_, String>((title, text))
+    })?;
+    drop(context);
+
+    let (_runtime, context, interrupted) = limited()?;
+    let started = Instant::now();
+    let stopped = context.with(|ctx| {
+        Module::declare(ctx.clone(), "busy.js", BUSY_LOOP)
+            .and_then(|module| module.eval())
+            .and_then(|(module, _)| module.get::<_, Function>("search"))
+            .and_then(|search| search.call::<_, Value>(()))
+            .is_err()
+    });
+    let elapsed = started.elapsed();
+    if !(stopped && interrupted.get()) {
+        return Err("the interrupt handler did not stop a busy loop".into());
+    }
+    println!(
+        "js_runtime=ok title={title:?} text={text:?} bytecode_bytes={} interrupted_after_ms={} heap_limit={HEAP_LIMIT} stack_limit={STACK_LIMIT}",
+        bytecode.len(),
+        elapsed.as_millis(),
+    );
+    Ok(())
+}
