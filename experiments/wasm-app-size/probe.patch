+++ b/crates/dupin/src/wasm_probe.rs
@@ -0,0 +1,143 @@
+use std::{error::Error, fs, path::PathBuf};
+
+use wasmi::{Config, Engine, Linker, Module, Store, StoreLimits, StoreLimitsBuilder};
+
+const EMPTY_WASM: &[u8] = b"\0asm\x01\0\0\0";
+const QUERY_FUEL: u64 = 20_000_000;
+const MEMORY_LIMIT: usize = 16 * 1024 * 1024;
+
+struct HostState {
+    limits: StoreLimits,
+}
+
+pub(super) fn dispatch() -> bool {
+    let mut args = std::env::args();
+    let _ = args.next();
+    let Some(mode) = args.next() else {
+        return false;
+    };
+
+    match mode.as_str() {
+        "--dupin-wasmi-runtime-probe" => report(runtime_probe()),
+        #[cfg(feature = "wasmi-minimal")]
+        "--dupin-wasmi-minimal-probe" => report(minimal_guest_probe()),
+        #[cfg(feature = "wasmi-fend")]
+        "--dupin-wasmi-fend-probe" => {
+            let query = args.next().unwrap_or_else(|| "560 km to mi".to_owned());
+            report(fend_guest_probe(&query));
+        }
+        _ if mode.starts_with("--dupin-wasmi-") => {
+            report(Err(format!("unsupported probe argument {mode}").into()));
+        }
+        _ => return false,
+    }
+    true
+}
+
+fn report(result: Result<(), Box<dyn Error>>) {
+    if let Err(error) = result {
+        eprintln!("Wasm size probe failed: {error}");
+        std::process::exit(1);
+    }
+}
+
+fn engine() -> Engine {
+    let mut config = Config::default();
+    config.consume_fuel(true);
+    Engine::new(&config)
+}
+
+fn store(engine: &Engine) -> Result<Store<HostState>, wasmi::Error> {
+    let limits = StoreLimitsBuilder::new()
+        .memory_size(MEMORY_LIMIT)
+        .instances(1)
+        .tables(1)
+        .memories(1)
+        .trap_on_grow_failure(true)
+        .build();
+    let mut store = Store::new(engine, HostState { limits });
+    store.limiter(|state| &mut state.limits);
+    store.set_fuel(QUERY_FUEL)?;
+    Ok(store)
+}
+
+fn module(engine: &Engine, wasm: &[u8]) -> Result<Module, wasmi::Error> {
+    Module::new(engine, &mut &wasm[..])
+}
+
+fn ensure_no_imports(module: &Module) -> Result<(), Box<dyn Error>> {
+    if module.imports().next().is_some() {
+        return Err("size probe guests must not import host functions".into());
+    }
+    Ok(())
+}
+
+fn runtime_probe() -> Result<(), Box<dyn Error>> {
+    let engine = engine();
+    let module = module(&engine, EMPTY_WASM)?;
+    ensure_no_imports(&module)?;
+    let mut store = store(&engine)?;
+    Linker::new(&engine).instantiate_and_start(&mut store, &module)?;
+    println!("wasmi_runtime=ok memory_limit_bytes={MEMORY_LIMIT}");
+    Ok(())
+}
+
+#[cfg(feature = "wasmi-minimal")]
+fn minimal_guest_probe() -> Result<(), Box<dyn Error>> {
+    let wasm = plugin_resource("minimal_eval.wasm")?;
+    let engine = engine();
+    let module = module(&engine, &wasm)?;
+    ensure_no_imports(&module)?;
+    let mut store = store(&engine)?;
+    let instance = Linker::new(&engine).instantiate_and_start(&mut store, &module)?;
+    let eval = instance.get_typed_func::<(), i32>(&store, "eval")?;
+    let result = eval.call(&mut store, ())?;
+    println!("minimal_guest_result={result} wasm_bytes={}", wasm.len());
+    Ok(())
+}
+
+#[cfg(feature = "wasmi-fend")]
+fn fend_guest_probe(query: &str) -> Result<(), Box<dyn Error>> {
+    let wasm = plugin_resource("fend_calculator.wasm")?;
+    let engine = engine();
+    let module = module(&engine, &wasm)?;
+    ensure_no_imports(&module)?;
+    let mut store = store(&engine)?;
+    let instance = Linker::new(&engine).instantiate_and_start(&mut store, &module)?;
+    let abi_version = instance
+        .get_typed_func::<(), i32>(&store, "abi_version")?
+        .call(&mut store, ())?;
+    assert_eq!(abi_version, 1);
+    let alloc = instance.get_typed_func::<i32, i32>(&store, "dupin_alloc")?;
+    let eval = instance.get_typed_func::<(i32, i32, i32, i32), i32>(&store, "dupin_eval")?;
+    let free = instance.get_typed_func::<(i32, i32), ()>(&store, "dupin_free")?;
+    let memory = instance.get_memory(&store, "memory").ok_or("missing memory export")?;
+    let input = query.as_bytes();
+    let input_ptr = alloc.call(&mut store, input.len() as i32)?;
+    let output_ptr = alloc.call(&mut store, 128)?;
+    memory.write(&mut store, input_ptr as usize, input)?;
+    store.set_fuel(QUERY_FUEL)?;
+    let output_len = eval.call(
+        &mut store,
+        (input_ptr, input.len() as i32, output_ptr, 128),
+    )?;
+    if output_len <= 0 {
+        return Err(format!("guest returned error {output_len}").into());
+    }
+    let mut output = vec![0_u8; output_len as usize];
+    memory.read(&store, output_ptr as usize, &mut output)?;
+    println!("query={query:?} result={:?} wasm_bytes={}", String::from_utf8(output)?, wasm.len());
+    free.call(&mut store, (input_ptr, input.len() as i32))?;
+    free.call(&mut store, (output_ptr, 128))?;
+    Ok(())
+}
+
+fn plugin_resource(name: &str) -> Result<Vec<u8>, Box<dyn Error>> {
+    let mut resources = std::env::current_exe()?;
+    resources.pop();
+    resources.pop();
+    resources.push("Resources");
+    resources.push("Plugins");
+    resources.push(PathBuf::from(name));
+    Ok(fs::read(resources)?)
+}
