{
	"name": "clipboard-history",
	"version": "0.1.0",
	"private": true,
	"dupin": {
		"title": "Clipboard",
		"keyword": "clip",
		"icon": "sf:doc.on.clipboard",
		"main": "main.ts",
		"match": "words",
		"preferences": {
			"retention": {
				"type": "select",
				"title": "Keep copies for",
				"options": [
					"1d",
					"7d",
					"30d",
					"90d",
					"forever"
				],
				"default": "7d"
			},
			"includeImages": {
				"type": "checkbox",
				"title": "Clipboard images",
				"default": true
			},
			"includeFiles": {
				"type": "checkbox",
				"title": "Clipboard files",
				"default": true
			},
			"maxEntries": {
				"type": "number",
				"title": "Most copies kept",
				"min": 1,
				"max": 10000,
				"default": 200
			}
		},
		"capabilities": {
			"storage": {
				"quotaBytes": 67108864
			},
			"clipboard": [
				"watch",
				"write",
				"paste"
			]
		}
	}
}
