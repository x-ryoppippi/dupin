#!/usr/bin/env nu

const SYMBOLS = "Text Symbols"
const TONES = ["1F3FB" "1F3FC" "1F3FD" "1F3FE" "1F3FF"]
# An item takes 16 keywords, and main.ts makes its name the first, so typing the name matches it
# as a whole rather than only from the word after the emoji in its title.
const MAX_KEYWORDS = 15
const MAX_KEYWORD_BYTES = 64

# Write the package's catalogue.ts from Unicode's emoji list and CLDR's English and Japanese
# annotations. The output is committed; run this again only to move to other releases.
#
# Emoji 15.1 is what macOS 14.4 and later draw, and Dupin supports macOS 14, so a newer release
# would list emoji some Macs show as empty boxes. CLDR 45 annotates Emoji 15.1.
def main [--emoji: string = "15.1", --cldr: string = "45.0.0"]: nothing -> nothing {
    let package = $env.FILE_PWD | path dirname
    let list = http get --raw $"https://unicode.org/Public/emoji/($emoji)/emoji-test.txt"
    | decode-text
    let en = annotations en $cldr
    let ja = annotations ja $cldr
    let annotations = {
        en: ($en.plain | merge $en.derived)
        ja: ($ja.plain | merge $ja.derived)
    }
    let emoji_rows = emoji-rows $list
    let skins = skin-tones $emoji_rows
    let listed = $list
    | lines
    | parse --regex '; [a-z-]+\s*# (?<char>\S+) E[0-9.]+ '
    | get char
    | each { bare }
    let symbol_rows = $en.plain
    | columns
    | where {|char| $char not-in $listed and not (is-ascii $char) }
    | each {|char| {char: $char, name: null, section: $SYMBOLS} }
    let rows = $emoji_rows
    | where tone == null
    | each {|row| $row | insert skins ($skins | get --optional ($row.char | bare) | default []) }
    | append ($symbol_rows | insert skins [])
    | each {|row| encode $row $annotations }
    let sections = $rows | get section | uniq
    let lines = $rows | each {|row|
        let index = $sections | enumerate | where item == $row.section | first | get index
        [$row.char $row.name $index ($row.en | str join '|') ($row.ja | str join '|') $row.ja_name ($row.skins | str join '|')]
        | each { into string }
        | str join "\t"
        | quote
    }
    let source = [
        $"// Generated by scripts/generate.nu from Unicode Emoji ($emoji) and CLDR ($cldr). Each row is"
        "// tab-separated: the character, its name, its section's index, English and Japanese keywords"
        "// separated by `|`, its Japanese name and its five skin tones, light to dark, if it has them."
        "export const sections: string[] = ["
        ...($sections | each {|section| $"\t($section | quote)," })
        "];"
        ""
        "export const rows: string[] = ["
        ...($lines | each {|line| $"\t($line)," })
        "];"
        ""
    ]
    $source | str join "\n" | save --force ($package | path join catalogue.ts)
    print $"wrote ($rows | length) rows in ($sections | length) sections"
}

def decode-text []: any -> string {
    let raw = $in
    if ($raw | describe) == binary {
        $raw | decode utf-8
    } else {
        $raw
    }
}

# A locale's annotations of single characters and its derived ones of sequences: character to
# `{default, tts}`.
def annotations [locale: string, cldr: string]: nothing -> record {
    let base = $"https://raw.githubusercontent.com/unicode-org/cldr-json/($cldr)/cldr-json"
    let plain = http get $"($base)/cldr-annotations-full/annotations/($locale)/annotations.json"
    let derived = http get $"($base)/cldr-annotations-derived-full/annotationsDerived/($locale)/annotations.json"
    {
        plain: $plain.annotations.annotations
        derived: $derived.annotationsDerived.annotations
    }
}

# Every fully-qualified emoji in list order, outside the Component group, with the skin tone
# it applies when it applies exactly one.
def emoji-rows [list: string]: nothing -> list<record> {
    mut group = ""
    mut rows = []
    for line in ($list | lines) {
        if ($line | str starts-with "# group: ") {
            $group = $line | str substring 9..
            continue
        }
        let parsed = $line
        | parse --regex '^(?<codes>[0-9A-F ]+?)\s*; fully-qualified\s*# (?<char>\S+) E[0-9.]+ (?<name>.+)$'
        if ($parsed | is-empty) or $group == "Component" {
            continue
        }
        let row = $parsed | first
        let tones = $row.codes | split row " " | where $it in $TONES | uniq
        let tone = match ($tones | length) {
            0 => null
            1 => (
                $TONES
                | enumerate
                | where item == $tones.0
                | first
                | get index
            )
            _ => "mixed"
        }
        $rows = $rows | append {char: $row.char, name: $row.name, section: $group, tone: $tone}
    }
    $rows | where tone != "mixed"
}

# Each base emoji's five skin-tone variants, light to dark, by the base without U+FE0F.
def skin-tones [rows: list<record>]: nothing -> record {
    $rows
    | where tone != null
    | each {|row| $row | insert base ($row.char | str replace --all --regex '[\x{1F3FB}-\x{1F3FF}]' '' | bare) }
    | group-by base
    | transpose base variants
    | where {|entry| ($entry.variants | length) == 5 }
    | each {|entry| {$entry.base: ($entry.variants | sort-by tone | get char)} }
    | into record
}

# The character without U+FE0F, as CLDR keys its annotations.
def bare []: string -> string {
    $in | str replace --all "\u{FE0F}" ""
}

def is-ascii [char: string]: nothing -> bool {
    $char =~ '^[\x{20}-\x{7E}]+$'
}

# A row with its names and keywords from the annotations, each keyword within the catalogue's
# limits and none repeating the name.
def encode [row: record, annotations: record]: nothing -> record {
    let key = $row.char | bare
    let en = $annotations.en | get --optional $key | default ($annotations.en | get --optional $row.char)
    let ja = $annotations.ja | get --optional $key | default ($annotations.ja | get --optional $row.char)
    let name = $row.name | default ($en.tts?.0? | default "")
    if ($name | is-empty) {
        error make {msg: $"($row.char) has neither a Unicode nor a CLDR name"}
    }
    let ja_name = $ja.tts?.0? | default ""
    let en_words = $en.default? | default [] | where ($it | str lowercase) != ($name | str lowercase)
    # "旗: 日本" also finds the flag by "日本".
    let ja_words = $ja.default? | default [] | append ($ja_name | split row ": ") | where $it != ""
    let words = $en_words
    | append $ja_words
    | where {|word| ($word | str length --utf-8-bytes) <= $MAX_KEYWORD_BYTES }
    | each {|word| {word: $word, folded: ($word | str lowercase)} }
    | uniq-by folded
    | first $MAX_KEYWORDS
    | each { get word }
    let fields = [$row.char $name $ja_name] ++ $words ++ $row.skins
    if ($fields | any {|field| ($field | str contains "\t") or ($field | str contains "|") }) {
        error make {msg: $"($row.char) has a tab or `|` in its name or keywords"}
    }
    {
        char: $row.char
        name: $name
        section: $row.section
        en: ($words | where $it in $en_words)
        ja: ($words | where $it not-in $en_words)
        ja_name: $ja_name
        skins: $row.skins
    }
}

# A single-quoted JavaScript string, as oxfmt writes it.
def quote []: string -> string {
    let escaped = $in
    | str replace --all '\' '\\'
    | str replace --all "'" "\\'"
    | str replace --all "\t" '\t'
    $"'($escaped)'"
}
