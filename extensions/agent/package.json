{
	"name": "agent",
	"version": "0.1.0",
	"private": true,
	"dupin": {
		"title": "Coding Agents",
		"keyword": "agent",
		"icon": "sf:sparkles",
		"main": "main.ts",
		"capabilities": {
			"exec": {
				"processes": {
					"program": "/bin/ps",
					"args": [
						"-axww",
						"-o",
						"pid=,ppid=,uid=,user=,%cpu=,rss=,etime=,comm="
					],
					"output": true,
					"outputBytes": 1048576,
					"background": true
				},
				"commands": {
					"program": "/bin/ps",
					"args": [
						"-ww",
						"-o",
						"pid=,args=",
						"-p",
						"{pids}"
					],
					"output": true,
					"outputBytes": 1048576,
					"background": true
				},
				"cwd": {
					"program": "/usr/sbin/lsof",
					"args": [
						"-a",
						"-d",
						"cwd",
						"-F",
						"n",
						"-p",
						"{pids}"
					],
					"output": true,
					"background": true
				},
				"identify": {
					"program": "/bin/ps",
					"args": [
						"-o",
						"comm=",
						"-p",
						"{pid}"
					],
					"output": true
				},
				"terminate": {
					"program": "/bin/kill",
					"args": [
						"-TERM",
						"{pid}"
					]
				},
				"terminal": {
					"program": "/usr/bin/open",
					"args": [
						"-a",
						"Terminal",
						"{folder}/"
					]
				}
			}
		}
	}
}
