[private]
default:
    @just --list

# Install the site's dependencies from the lockfile
install:
    pnpm install --frozen-lockfile

# Start the dev server
dev: install
    pnpm run dev

# Build the static site
build: install
    pnpm run build

# Serve the built site locally
preview: install
    pnpm run preview

# Lint with oxlint, type-aware and type-checked through tsrs
lint: install
    pnpm run lint

# Run the tests: docs links, published pages and Open Graph cards
test: install
    pnpm run test

# Build, lint and test, as the Website workflow does
check: build lint test

# Build and deploy the static site
deploy: install
    pnpm run deploy

# Regenerate the Japanese display-font subset from the characters in docs/
font:
    nu scripts/subset-ja-font.nu
