[private]
default:
    @just --list

# Install the site's dependencies from the lockfile
install:
    pnpm install --frozen-lockfile

# Start the dev server
dev:
    pnpm run dev

# Build the Worker and its static assets
build:
    pnpm run build

# Serve the built site locally
preview:
    pnpm run preview

# Lint with oxlint, type-aware and type-checked through tsrs
lint:
    pnpm run lint

# Build and deploy the Worker and its static assets
deploy:
    pnpm run deploy
