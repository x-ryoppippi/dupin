{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["vite/client", "node", "svelte"]
	},
	"include": ["src/**/*.ts", "vite.config.ts", "cloudflare.config.ts", "oxlint.config.ts"]
}
